# Container-network settings for `docker compose --profile app`.
# Copy to infrastructure/.env.docker and pass with --env-file when overriding values.
# Do not commit real secrets. JWT_SECRET must still come from the root .env.

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://procurement:procurement@postgres:5432/procurement
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=procurement
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
CHECKPOINTER_DATABASE_URL=postgresql://procurement:procurement@postgres:5432/procurement
WORKFLOW_AS_OF=2026-01-15

# Optional production-like provider settings
LLM_PROVIDER=simulator
LANGSMITH_TRACING=false
