APP_ENV=development
DATABASE_URL=postgresql+asyncpg://procurement:procurement@localhost:5432/procurement
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=procurement
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
FASTEMBED_CACHE_DIR=
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RESULT_LIMIT=5
RETRIEVAL_MIN_DENSE_SCORE=0.60
RETRIEVAL_MIN_SPARSE_SCORE=2.0
RETRIEVAL_MIN_TEXT_CHARS=40
RRF_K=60
LLM_PROVIDER=
LLM_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
JWT_SECRET=change-me-in-local-only
JWT_ISSUER=agentic-procurement
JWT_AUDIENCE=agentic-procurement-api
CHECKPOINTER_DATABASE_URL=postgresql://procurement:procurement@localhost:5432/procurement
GRAPH_CHECKPOINTER_ENABLED=true
WORKFLOW_RECURSION_LIMIT=25
# Demo reference date that matches the synthetic dataset (quotes expire 2026-04-01).
# Leave unset to use today's date.
WORKFLOW_AS_OF=2026-01-15
WORKFLOW_SUPPLIER_TIMEOUT_SECONDS=5
WORKFLOW_POLICY_TIMEOUT_SECONDS=8
